POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=app_password
POSTGRES_PORT=5432

DJANGO_SECRET_KEY=change_me_in_production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5180
JWT_ACCESS_LIFETIME_SECONDS=3600
JWT_REFRESH_LIFETIME_SECONDS=604800
REDIS_URL=redis://localhost:6379/0
CHANNEL_LAYERS_BACKEND=channels_redis.core.RedisChannelLayer
DJANGO_CACHE_BACKEND=django.core.cache.backends.redis.RedisCache
DJANGO_CACHE_LOCATION=redis://localhost:6379/1
AI_PROVIDER=xkiro
AI_BASE_URL=https://api.xkiro.com/v1
AI_API_KEY=
AI_MODEL=mistralai/mistral-large-2512
AI_TIMEOUT_SECONDS=60
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.1
AI_MAX_PROMPT_CHARS=4000
AI_MAX_CONTEXT_ITEMS=1000
AI_MAX_OPERATIONS=200
AI_TRANSCRIPTION_BACKEND=local
AI_TRANSCRIPTION_LOCAL_MODEL=base
AI_TRANSCRIPTION_LOCAL_DEVICE=cpu
AI_TRANSCRIPTION_LOCAL_COMPUTE_TYPE=int8
AI_TRANSCRIPTION_LOCAL_CPU_THREADS=4
AI_TRANSCRIPTION_PRELOAD=True
AI_TRANSCRIPTION_BASE_URL=
AI_TRANSCRIPTION_API_KEY=
AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
AI_TRANSCRIPTION_TIMEOUT_SECONDS=60
AI_TRANSCRIPTION_MAX_BYTES=10485760
MODEL_SNAPSHOT_INTERVAL=50
DJANGO_PORT=8000
REACT_PORT=5180
VITE_ENABLE_EA_INTERCHANGE=false
